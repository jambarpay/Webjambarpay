{
  "name": "jambaar-pay-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "typecheck:e2e": "tsc --project tsconfig.playwright.json",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck:e2e && npm run test:ci && npm run build && npm run e2e"
  },
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.26",
    "@angular/compiler": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@angular/forms": "^20.3.26",
    "@angular/platform-browser": "^20.3.26",
    "@angular/platform-browser-dynamic": "^20.3.26",
    "@angular/router": "^20.3.26",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "primeicons": "^8.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.26",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^20.19.43",
    "angular-eslint": "22.1.0",
    "eslint": "^10.8.0",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.65.0"
  }
}
